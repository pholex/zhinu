# 复制成 .env 后填写。BASE_URL 是任意 OpenAI 兼容 /v1 端点（LiteLLM、vLLM、官方 API…）
# 最短路径：只填 DEEPSEEK_API_KEY 即可直连官方，不需要网关（macOS 也可存 Keychain，同名）
DEEPSEEK_API_KEY=
XIAOYU_BASE_URL=https://<你的网关>/v1
XIAOYU_MODEL=deepseek-v4-pro
XIAOYU_SUMMARY_MODEL=deepseek-v4-flash
XIAOYU_API_KEY=
#  当前模型看不了图时，把图先交给这个模型代读成文字（留空 = 不代读，见 docs/configuration.md）
XIAOYU_VISION_FALLBACK=
