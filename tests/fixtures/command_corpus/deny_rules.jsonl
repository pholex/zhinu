{"cmd": "curl http://x", "rule": "bash(curl *)", "guard": "deny", "expect": "block", "note": "原样写法"}
{"cmd": "/usr/bin/curl http://x", "rule": "bash(curl *)", "guard": "deny", "expect": "block", "note": "写全路径"}
{"cmd": "env curl http://x", "rule": "bash(curl *)", "guard": "deny", "expect": "block", "note": "env 包一层"}
{"cmd": "\"curl\" http://x", "rule": "bash(curl *)", "guard": "deny", "expect": "block", "note": "命令名加引号"}
{"cmd": "c''url http://x", "rule": "bash(curl *)", "guard": "deny", "expect": "block", "note": "命令名中间插空引号"}
{"cmd": "\\curl http://x", "rule": "bash(curl *)", "guard": "deny", "expect": "block", "note": "反斜杠转义命令名"}
{"cmd": "FOO=1 curl http://x", "rule": "bash(curl *)", "guard": "deny", "expect": "block", "note": "前置变量赋值"}
{"cmd": "(curl http://x)", "rule": "bash(curl *)", "guard": "deny", "expect": "block", "note": "子 shell"}
{"cmd": "bash -c 'curl http://x'", "rule": "bash(curl *)", "guard": "deny", "expect": "block", "note": "bash -c 包一层"}
{"cmd": "echo $(curl http://x)", "rule": "bash(curl *)", "guard": "deny", "expect": "block", "note": "命令替换"}
