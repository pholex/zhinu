{"cmd": "rg -z pattern", "guard": "injection", "expect": "block", "note": "-z 搜索预处理"}
{"cmd": "tar --to-command=evil -xf a.tar", "guard": "injection", "expect": "block", "note": "tar 每文件跑程序"}
{"cmd": "ssh -o ProxyCommand=evil host", "guard": "injection", "expect": "block", "note": "ssh ProxyCommand"}
{"cmd": "ssh -oProxyCommand=evil host", "guard": "injection", "expect": "block", "note": "-o 粘连写法"}
{"cmd": "xargs rm", "guard": "injection", "expect": "block", "note": "xargs 跑任意命令"}
