{"cmd": "git -c core.pager='!sh evil' log", "guard": "injection", "expect": "block", "note": "git -c 注入 pager"}
{"cmd": "git -ccore.pager=evil log", "guard": "injection", "expect": "block", "note": "-c 粘连写法"}
{"cmd": "git -p log", "guard": "injection", "expect": "block", "note": "-p 触发 pager"}
{"cmd": "git --exec-path=/tmp/evil status", "guard": "injection", "expect": "block", "note": "改 exec-path"}
{"cmd": "git --git-dir /tmp/other status", "guard": "injection", "expect": "block", "note": "改 git-dir"}
{"cmd": "git diff --ext-diff", "guard": "injection", "expect": "block", "note": "外部 diff 程序"}
{"cmd": "git diff --output=/tmp/x", "guard": "injection", "expect": "block", "note": "指定输出文件"}
{"cmd": "/usr/bin/git -c a.b=c log", "guard": "injection", "expect": "block", "note": "绝对路径不绕过按名检查"}
{"cmd": "git.exe -p log", "guard": "injection", "expect": "block", "note": "Windows 后缀不绕过"}
{"cmd": "find . -name '*.py' -exec rm {} ;", "guard": "injection", "expect": "block", "note": "find -exec 任意程序"}
{"cmd": "find . -delete", "guard": "injection", "expect": "block", "note": "find -delete"}
{"cmd": "rg --pre=evil pattern", "guard": "injection", "expect": "block", "note": "ripgrep --pre 预处理器"}
